# A day's results, copied off the machine holding them.
#
# The stakes are lower than they look. This receiver is a **mirror** — the
# authoritative copy of a day is the log on the machine that raced it, written
# there before anything else knew a result existed (D33). Losing this loses a
# mirror, and re-pushing restores it.
#
# So this is a convenience, and it is a `tar` rather than anything cleverer
# because the state is a few kilobytes of text per event. That is not a saving,
# it is the design: two files and a token, readable with `cat`.
#
#   install -m0644 deploy/beam402-backup.{service,timer} /etc/systemd/system/
#   systemctl enable --now beam402-backup.timer
#
# Send the archives somewhere else as well — a Storage Box, an object bucket, a
# laptop. A backup on the same disk as the thing it is backing up is a copy, not
# a backup.

[Unit]
Description=Archive the beam402 results store
After=beam402-host.service

[Service]
Type=oneshot

# **No `StateDirectory=` here, and that is the whole point of this comment.**
# Declaring the receiver's state directory in a second unit looks like the tidy
# way to say "the same files" and is a trap: `systemd` owns the layout of a state
# directory, and where it puts one depends on `DynamicUser`. The receiver is
# dynamic, so its store lives in /var/lib/private/beam402, with /var/lib/beam402
# a symlink to it. This unit is root. Declaring the same directory from a unit
# that is *not* dynamic makes `systemd` **migrate** it: the real directory moves
# to /var/lib/beam402
# and the symlink is gone. The receiver, still holding the path /var/lib/beam402
# and a read-only root, then answers every upload with
# `500: Read-only file system` — while serving reads perfectly, so it looks well.
# On an hourly timer that happened once an hour.
#
# Reading a path needs no declaration. This unit just reads it.
#
# `h` dereferences. /var/lib/beam402 is that symlink, and `tar` without `h`
# archives the symlink rather than the day.
ExecStart=/bin/sh -c 'set -eu; \
  d=/var/backups/beam402; mkdir -p "$d"; \
  tar czhf "$d/beam402-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).tar.gz" -C /var/lib beam402; \
  ls -1t "$d"/beam402-*.tar.gz | tail -n +31 | xargs -r rm --'

# Root, and deliberately. `systemd` keeps /var/lib/private at 0700 root, so
# no unprivileged user can read the store this exists to archive — and a
# second `DynamicUser` service would be a second dynamic UID with a `chown`
# claim on the receiver's own `StateDirectory`. Reading a state directory and
# writing a tar is what root is for; nothing here opens a socket.
#
# `full` rather than `strict`: /usr, /boot and /etc read-only, /var writable.
# `strict` wants every writable path declared, and a declared path is a bind
# mount — which systemd cannot make from a directory that does not exist yet,
# so the first run on a new machine failed at step NAMESPACE before any shell
# could create it. `ExecStartPre=+` does not help: `+` drops the privilege
# restrictions, not the namespace.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
LockPersonality=yes

[Install]
WantedBy=multi-user.target
