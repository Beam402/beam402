# TLS and rate limiting in front of `beam402 host`, which has neither and is
# not the thing facing the internet (D32, D33).
#
#   caddy run --config deploy/Caddyfile
#
# Replace the site address. Caddy obtains and renews the certificate itself,
# which is the one part of this that is genuinely easier than doing it inside
# the binary — and the reason D32 could leave TLS out.

results.example.org {
	# Compression for browsers only. `beam402 push` asks for `identity` and does
	# not decompress, and a proxy that gzipped a reply anyway would hand it a body
	# it cannot read — so this is matched to GET rather than left global.
	@pages method GET HEAD
	encode @pages zstd gzip

	# The receiver tells this proxy how long each answer may be reused — five
	# seconds for a day in progress, five minutes for one that is settled, and
	# `no-store` for anything an uploader reads (D33). Caddy does not cache on its
	# own; put a cache module or a CDN in front if a grandstand ever refreshes hard
	# enough to matter. The headers are already correct for whatever does it.
	#
	# The receiver, on loopback only. Nothing else may reach it.
	reverse_proxy 127.0.0.1:8403 {
		# It answers in milliseconds; anything slower is not a slow day.
		transport http {
			read_timeout 30s
		}
	}

	# Rate limiting is **not** in stock Caddy. `rate_limit` comes from
	# caddy-ratelimit and needs a custom build — `xcaddy`, or the binary
	# `caddy add-package` fetches. With the packaged Caddy this file did not
	# start at all: `unrecognized directive: rate_limit`. So it is commented
	# out rather than assumed, because a reference file that does not start is
	# worse than one that does less — and because an `apt` upgrade puts the
	# stock binary back, turning a routine upgrade into a site that stops.
	#
	# The token is the write authority either way (D33); this only made
	# guessing one expensive. Plugin-free ways to get that back: a long token
	# (`openssl rand -hex 32`), `fail2ban` over the log below, or a CDN that
	# rate-limits in front.
	#
	# @writes method POST
	# rate_limit @writes {
	# 	zone writes {
	# 		key {remote_host}
	# 		events 60
	# 		window 1m
	# 	}
	# }

	header {
		# Nothing here is embeddable and nothing here is a script host.
		Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		# Result pages are public and the token travels in a header, so a request
		# log is safe — but say so deliberately rather than by default.
		output file /var/log/caddy/beam402.log
		format json
	}
}
